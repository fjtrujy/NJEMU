# Validate checked-in PSP and PS Vita metadata artwork without image tool dependencies.
if(NOT DEFINED NJEMU_ARTWORK_ROOT)
    set(NJEMU_ARTWORK_ROOT "${CMAKE_CURRENT_LIST_DIR}/../data/artwork")
endif()

function(njemu_assert_png path expected_width expected_height expected_color_type)
    if(NOT EXISTS "${path}")
        message(FATAL_ERROR "Missing platform artwork: ${path}")
    endif()
    file(READ "${path}" _header HEX LIMIT 26)
    string(SUBSTRING "${_header}" 0 16 _signature)
    if(NOT _signature STREQUAL "89504e470d0a1a0a")
        message(FATAL_ERROR "Not a PNG file: ${path}")
    endif()
    string(SUBSTRING "${_header}" 32 8 _width_hex)
    string(SUBSTRING "${_header}" 40 8 _height_hex)
    string(SUBSTRING "${_header}" 48 2 _depth_hex)
    string(SUBSTRING "${_header}" 50 2 _type_hex)
    math(EXPR _width "0x${_width_hex}")
    math(EXPR _height "0x${_height_hex}")
    if(NOT _width EQUAL expected_width OR NOT _height EQUAL expected_height
            OR NOT _depth_hex STREQUAL "08" OR NOT _type_hex STREQUAL expected_color_type)
        message(FATAL_ERROR "Unexpected PNG metadata: ${path} (${_width}x${_height}, depth ${_depth_hex}, type ${_type_hex})")
    endif()
endfunction()

foreach(_core IN ITEMS cps1 cps2 mvs ncdz)
    set(_assets "${NJEMU_ARTWORK_ROOT}/${_core}")
    if(NOT NJEMU_ARTWORK_GENERATED_ONLY)
        njemu_assert_png("${_assets}/source_1666_944.png" 1666 944 "02")
        njemu_assert_png("${_assets}/icon_source_1254_1254.png" 1254 1254 "02")
    endif()
    njemu_assert_png("${_assets}/icon_144_80.png" 144 80 "06")
    njemu_assert_png("${_assets}/pic0_480_272.png" 480 272 "06")
    njemu_assert_png("${_assets}/pic1_480_272.png" 480 272 "06")
    njemu_assert_png("${_assets}/icon_128_128.png" 128 128 "03")
    njemu_assert_png("${_assets}/pic0_960_544.png" 960 544 "03")
    njemu_assert_png("${_assets}/bg_840_500.png" 840 500 "03")
    njemu_assert_png("${_assets}/startup_280_158.png" 280 158 "03")
endforeach()
if(NOT NJEMU_ARTWORK_GENERATED_ONLY AND NOT EXISTS "${NJEMU_ARTWORK_ROOT}/template.xml")
    message(FATAL_ERROR "Missing Vita LiveArea template")
endif()
message(STATUS "NJEMU PSP and PS Vita artwork: validated all four cores")
