--- a/src/padInit.c
+++ b/src/padInit.c
@@ -44,6 +44,21 @@
 int sifdma_id = 0;
 u32 vblankStartCount = 0;
 s32 mainThreadCount = 0;
+
+#ifdef NJEMU_PADMAN_TIMER_POLL_US
+static iop_sys_clock_t nj_timer_period;
+int nj_timer_active = 0;
+
+unsigned int nj_padman_timer_poll(void *arg)
+{
+	vblankData_t *data = (vblankData_t *)arg;
+	if (data->init && !data->stopTransfer) {
+		data->stopTransfer = 1;
+		iSetEventFlag(data->eventflag, EF_VB_TRANSFER);
+	}
+	return nj_timer_period.lo;
+}
+#endif
 
 static void TransferThread(void *arg)
 {
@@ -664,7 +679,11 @@
 	vblankStartCount++;
 	frame_count++;
 
-	if((vData->init == 1) && (vData->stopTransfer == 0))
+	if((vData->init == 1) && (vData->stopTransfer == 0)
+#ifdef NJEMU_PADMAN_TIMER_POLL_US
+	   && !nj_timer_active
+#endif
+	)
 	{
 		vData->stopTransfer = 1;
 		iSetEventFlag(vData->eventflag, EF_VB_TRANSFER);
@@ -781,5 +800,16 @@
 	vblankData.init = 1;
 	padman_init = 1;
 
+#ifdef NJEMU_PADMAN_TIMER_POLL_US
+	USec2SysClock(NJEMU_PADMAN_TIMER_POLL_US, &nj_timer_period);
+	if (SetAlarm(&nj_timer_period, nj_padman_timer_poll, &vblankData) == 0) {
+		nj_timer_active = 1;
+		M_PRINTF("experimental PADMAN timer poll interval: %d us\n",
+			NJEMU_PADMAN_TIMER_POLL_US);
+	} else {
+		M_PRINTF("experimental timer unavailable, using VBlank polling\n");
+	}
+#endif
+
 	return 1;
 }
